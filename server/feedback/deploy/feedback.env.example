# 反馈后端配置模板（**占位符版，进仓库的就是这一份**）
#
# 真正生效的那份在服务器的 /etc/feedback.env（权限 600、owner root）。
# 装法见 server/feedback/RUNBOOK.md §2：把本文件复制成 /tmp/feedback.env.new、
# 只替换下面那一行为真实密码、再交给 deploy/install.sh 的第二个参数。
#
# ★ 仓库里的任何文件都不许出现真实密码 —— 本文件里就是 __SET_ME__。
FEEDBACK_PASSWORD=__SET_ME__

# 只监听本机，由 nginx 反代出去
FEEDBACK_HOST=127.0.0.1
FEEDBACK_PORT=8790

# 数据目录：items/<id>/（meta.json + 附件原件）、trash/（软删除的去处）、rate/（额度记账）
FEEDBACK_DATA_DIR=/var/lib/compile-feedback

# 日志：超过 FEEDBACK_LOG_MAX_BYTES 自己轮转成 <file>.1
FEEDBACK_LOG_FILE=/var/log/feedback.log
FEEDBACK_LOG_MAX_BYTES=5242880

# 走 nginx 反代时必须开：IP 取 X-Forwarded-For 的最后一跳，限流按它算
FEEDBACK_TRUST_PROXY=1

# 契约值（前端照这套写，别单方面改）
FEEDBACK_MAX_FILE_BYTES=10485760
FEEDBACK_MAX_FILES=5
FEEDBACK_FILES_PER_IP_PER_DAY=5

# 会话 12 小时（与 Cookie 的 Max-Age=43200 对齐）；重启即失效（契约说可接受）
FEEDBACK_SESSION_TTL=43200

# 登录失败闸：同一 IP 在 FEEDBACK_LOGIN_FAIL_WINDOW 秒内失败 >= FEEDBACK_LOGIN_FAIL_MAX 次，一律 429
FEEDBACK_LOGIN_FAIL_MAX=5
FEEDBACK_LOGIN_FAIL_WINDOW=600
